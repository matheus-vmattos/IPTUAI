PORT=4000
JWT_SECRET=troque-este-segredo-em-producao

# Banco de dados: em branco usa SQLite local em ./data/iptuai.db (bom para
# desenvolvimento). Em producao, preencha com um banco Turso gratuito
# (https://turso.tech) para persistir os dados sem depender de disco local.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DB_PATH=./data/iptuai.db

# Usuario admin criado automaticamente na primeira execucao se nao existir nenhum usuario
ADMIN_EMAIL=admin@iptuai.local
ADMIN_PASSWORD=troque-esta-senha
